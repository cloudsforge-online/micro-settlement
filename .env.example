# settlement — the outbound chain service.
#
# Every variable this service reads is declared in src/env.ts and appears here. Nothing else is
# provided to the container: rule 9 of docs/ecosystem/03 §2 exists so that `env_file: .env` fan-out,
# which hands every container the whole estate's secrets, has nothing to justify it. In THIS service
# that matters more than most — the process below holds the credential that can ask custody to sign
# a payment out of the treasury.
#
# Copy to .env and replace every value marked REPLACE. The service refuses to start on a known
# placeholder, and it names the variable when it does.

# ── the service itself ────────────────────────────────────────────────────────
PORT=4008
NODE_ENV=development
LOG_LEVEL=info
# The container id under compose and the pod name under Kubernetes. Names this replica in
# jobs.locked_by, which is the thing an operator searches for after finding a stuck lease.
# INSTANCE_ID=

# ── the database. ONE connection string, and CI greps for a second ────────────
SETTLEMENT_DATABASE_URL=postgres://settlement:settlement@127.0.0.1:5432/settlement
SETTLEMENT_DATABASE_POOL_MAX=10

# ── identity ──────────────────────────────────────────────────────────────────
IDENTITY_JWKS_URL=http://127.0.0.1:4001/.well-known/jwks.json
IDENTITY_ISSUER=http://127.0.0.1:4001

# ── the outbox HMAC ───────────────────────────────────────────────────────────
# Signs the events this service emits AND verifies the ones wallet's relay sends, so both ends of
# every subscription this service is part of must hold the same value.
# REPLACE: openssl rand -hex 24
OUTBOX_SIGNING_SECRET=REPLACE-with-openssl-rand-hex-24

# ── the upstreams ─────────────────────────────────────────────────────────────
CUSTODY_URL=http://127.0.0.1:4005
INDEXER_URL=http://127.0.0.1:4006
LEDGER_URL=http://127.0.0.1:4004
SETTLEMENT_UPSTREAM_DEADLINE_MS=8000

# The scoped service credential. NOT a shared token — SD-05. It must carry:
#   custody:sign:treasury    pay a withdrawal out of the treasury
#   custody:sign:deposit     sweep a deposit address into the pinned treasury
#   custody:treasury:read    read the pin (it can never write one; that is administrator-only)
#   indexer:read             ask what became of a transaction hash
#   ledger:post              journal the network fee a confirmed transaction burned
# A deployment that does not sweep should not be issued custody:sign:deposit.
# REPLACE
SETTLEMENT_SERVICE_TOKEN=REPLACE-with-a-scoped-service-token

# ── the chain ─────────────────────────────────────────────────────────────────
# One network per deployment. A service that could be asked to sweep on either is one bad request
# away from consolidating a testnet float into a mainnet treasury.
SETTLEMENT_NETWORK=testnet

# chain → JSON-RPC endpoint. A chain absent from this map refuses everything rather than falling
# back to a public node nobody chose. Only `ember` and `eth` have adapters today; `btc`, `sol` and
# `xrp` are real objects that name the phase that brings them.
SETTLEMENT_RPC_URLS={"ember":"http://127.0.0.1:8545"}
SETTLEMENT_RPC_DEADLINE_MS=10000

# ── the fee bounds ────────────────────────────────────────────────────────────
# These two numbers decide whether a signature is asked for at all, and both directions cost money.
# A floor of zero lets a node quoting nothing produce a transaction that underbids its own chain and
# then sits in a mempool being neither paid nor refunded. A ceiling that is too high lets a
# misbehaving node spend a user's whole balance on gas.
SETTLEMENT_MIN_GAS_PRICE_WEI=1000000000
SETTLEMENT_MAX_GAS_PRICE_WEI=500000000000
# The most one transaction's gasLimit × gasPrice may come to. Kept BELOW custody's own ceiling of
# 2e18 on purpose: this service should refuse a transaction it would otherwise ask custody to
# refuse, so an operator sees a classified build failure with a refund rather than a 403 from a
# service they do not run.
SETTLEMENT_MAX_FEE_WEI=1000000000000000000

# ── the worker ────────────────────────────────────────────────────────────────
SETTLEMENT_WITHDRAWALS_ENABLED=true
# How long an unsettled transaction may go unresolved before it becomes `stuck`. A stuck transaction
# is NEVER auto-refunded; it pages an operator and waits for POST /v1/outbound/:id/adjudicate.
SETTLEMENT_STUCK_MINUTES=60

# ── sweeping ──────────────────────────────────────────────────────────────────
# OFF by default, and that is a decision about custody rather than a limitation. Moving a coin from
# a deposit address to the treasury moves it INTO the blast radius of the signing credential: a
# leaked token buying the float is a different-sized incident from one buying every deposit ever
# made. Turning this on drives sweeps that are already in flight either way.
SETTLEMENT_SWEEP_ENABLED=false

# The float an operator wants sitting in each treasury, as whole units per asset. EMPTY means zero,
# which makes the sweeper demand-driven: it moves what queued withdrawals need and nothing else.
# Example: {"EMBER":"250"}
SETTLEMENT_TREASURY_TARGETS={}

# A sweep is only worth making when the balance is this many times the fee. Sweeping an address
# holding barely more than the fee spends most of the customer's deposit on moving it.
SETTLEMENT_SWEEP_MIN_FEE_MULTIPLE=3

# ── tests ─────────────────────────────────────────────────────────────────────
# Read ONLY by the test suite, and only when its name contains "test": `resetSettlement` truncates
# every table this service owns, and the name check is the difference between a red build and an
# emptied environment. This service holds the only record of which signed bytes exist for which
# payment.
# SETTLEMENT_TEST_DATABASE_URL=postgres://settlement:settlement@127.0.0.1:5432/settlement_test
